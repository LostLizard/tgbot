# Скопируйте этот файл в `.env` и заполните токен.

# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# --- Источники меню (можно оставить по умолчанию) ---
# Яндекс.Диск: ссылка на просмотр документа
YANDEX_URL=https://docs.yandex.ru/view/d/EXkkK1_gh5Yidw-R4VR_KSPegnqahzm72s0qoIz-cKg6dC1YR3ljcjJhZw

# Google Sheets: ID таблицы
GOOGLE_SHEET_ID=1JXy4B539T_hAe9Y3DUgOFKuPAWSj27zA_L0pehWgdfY

# Вкладки Excel, которые не показывать (через запятую)
SKIP_SHEETS=Утро

# Период перечитывания Excel, сек
CACHE_TTL_SECONDS=3600

# --- Обход блокировок Telegram (если api.telegram.org недоступен) ---
# HTTP/HTTPS/SOCKS5-прокси (от VPN, v2rayN, Clash и т.п.).
# Примеры:
#   TELEGRAM_PROXY=http://127.0.0.1:8080
#   TELEGRAM_PROXY=socks5://127.0.0.1:10808
TELEGRAM_PROXY=
